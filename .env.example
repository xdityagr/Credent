# ---- API (apps/api) ----
# Postgres from infra/docker-compose.yml (port 5434)
DATABASE_URL=postgresql+psycopg://credent:credent@localhost:5434/credent

# Links in emails point here
APP_URL=http://localhost:3000

# Email: Mailpit catches everything locally (inbox at http://localhost:8025).
# For real email set your SMTP provider, e.g. Gmail app password or Resend SMTP.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=Credent <no-reply@credent.local>

# Solana:
#   local  = real SPL token programs in an in-process Solana VM (no setup; rebuilt from the DB on restart)
#   devnet = Solana devnet. Fund the fee payer once at https://faucet.solana.com
#            (address: `uv run python ../../scripts/devnet.py status` from apps/api)
CHAIN_MODE=local
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_ENABLED=true

# ZK prover: "docker" (credent-prover image) or "local" (nargo + bb on PATH)
PROVER=docker
PROVER_IMAGE=credent-prover

# Demo world: seeded on first boot; demo logins at /login. Accelerated clock: one protocol day every N seconds.
SIM_ENABLED=true
SEED_DEMO=true
CLOCK_MODE=accelerated
SECONDS_PER_DAY=120

# ---- Web (apps/web) ----
API_URL=http://localhost:8000
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
