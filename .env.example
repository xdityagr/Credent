# ---- API (apps/api) ----
# ZK prover: "docker" (default, uses the credent-prover image) or "local" (nargo + bb on PATH)
PROVER=docker
PROVER_IMAGE=credent-prover

# Anchor ledger block roots to Solana devnet. The API prints the anchor address in
# /public/status; fund it once at https://faucet.solana.com (devnet) if the airdrop is rate-limited.
ANCHOR_ENABLED=true
SOLANA_RPC_URL=https://api.devnet.solana.com

# Demo simulation controls (advance time, inject payments, defaults).
SIM_ENABLED=true

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
